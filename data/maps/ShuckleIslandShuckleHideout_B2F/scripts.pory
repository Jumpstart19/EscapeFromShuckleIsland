script ShuckleIslandShuckleHideout_B2F_EventScript_Petrel {

    lock
    faceplayer

    if (!flag(FLAG_PETREL_PRE_BATTLE_7)) {

        msgbox(petrelBattle7Intro_text)
        setflag(FLAG_PETREL_PRE_BATTLE_7)

    }

    if(!flag(FLAG_RECEIVED_BERRY_7)) {

        msgbox(berryGuyPresentOptions_text)

        dynmultipush("Occa Berry", ITEM_OCCA_BERRY)
        dynmultipush("Passho Berry", ITEM_PASSHO_BERRY)
        dynmultipush("Wacan Berry", ITEM_WACAN_BERRY)
        dynmultipush("Rindo Berry", ITEM_RINDO_BERRY)
        dynmultipush("Yache Berry", ITEM_YACHE_BERRY)
        dynmultipush("Chople Berry", ITEM_CHOPLE_BERRY)
        dynmultipush("Kebia Berry", ITEM_KEBIA_BERRY)
        dynmultipush("Shuca Berry", ITEM_SHUCA_BERRY)
        dynmultipush("Coba Berry", ITEM_COBA_BERRY)
        dynmultipush("Payapa Berry", ITEM_PAYAPA_BERRY)
        dynmultipush("Tanga Berry", ITEM_TANGA_BERRY)
        dynmultipush("Charti Berry", ITEM_CHARTI_BERRY)
        dynmultipush("Kasib Berry", ITEM_KASIB_BERRY)
        dynmultipush("Haban Berry", ITEM_HABAN_BERRY)
        dynmultipush("Colbur Berry", ITEM_COLBUR_BERRY)
        dynmultipush("Babiri Berry", ITEM_BABIRI_BERRY)
        dynmultipush("Chilan Berry", ITEM_CHILAN_BERRY)

        dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)

        if (var(VAR_RESULT) == 127) {

            msgbox("I don't blame you. I doubt a single\nberry would make a difference.")

        }
        else {

            copyvar(VAR_BATTLE7_BERRY, VAR_RESULT)
            giveitem(VAR_BATTLE7_BERRY, 1)
            setflag(FLAG_RECEIVED_BERRY_7)

        }
    }

    if(flag(FLAG_LAST_STAND_TRIGGERED) && !flag(FLAG_RECEIVED_BERRY_7_2)) {

        if (!flag(FLAG_PETREL_PRE_BATTLE_7_2)) {

            msgbox(petrelBattle7Intro2_text)
            setflag(FLAG_PETREL_PRE_BATTLE_7_2)

        }

        msgbox(berryGuyPresentOptions2_text)

        dynmultipush("Occa Berry", ITEM_OCCA_BERRY)
        dynmultipush("Passho Berry", ITEM_PASSHO_BERRY)
        dynmultipush("Wacan Berry", ITEM_WACAN_BERRY)
        dynmultipush("Rindo Berry", ITEM_RINDO_BERRY)
        dynmultipush("Yache Berry", ITEM_YACHE_BERRY)
        dynmultipush("Chople Berry", ITEM_CHOPLE_BERRY)
        dynmultipush("Kebia Berry", ITEM_KEBIA_BERRY)
        dynmultipush("Shuca Berry", ITEM_SHUCA_BERRY)
        dynmultipush("Coba Berry", ITEM_COBA_BERRY)
        dynmultipush("Payapa Berry", ITEM_PAYAPA_BERRY)
        dynmultipush("Tanga Berry", ITEM_TANGA_BERRY)
        dynmultipush("Charti Berry", ITEM_CHARTI_BERRY)
        dynmultipush("Kasib Berry", ITEM_KASIB_BERRY)
        dynmultipush("Haban Berry", ITEM_HABAN_BERRY)
        dynmultipush("Colbur Berry", ITEM_COLBUR_BERRY)
        dynmultipush("Babiri Berry", ITEM_BABIRI_BERRY)
        dynmultipush("Chilan Berry", ITEM_CHILAN_BERRY)

        dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)

        if (var(VAR_RESULT) == 127) {

            msgbox("I don't blame you. I doubt another\nberry would make a difference.")

        }
        else {

            copyvar(VAR_BATTLE7_BERRY_2, VAR_RESULT)
            giveitem(VAR_BATTLE7_BERRY_2, 1)
            setflag(FLAG_RECEIVED_BERRY_7_2)

        }
    }
    else {

        msgbox("I'd say good luck, but you should now\nunderstand you don't stand a chance.")

    }

    release
    end

}

script ShuckleIslandShuckleHideout_B2F_EventScript_resetNPC7 {

    lockall
    faceplayer

    if(!flag(FLAG_SPOKE_RESET_NPC)) {

        setflag(FLAG_SPOKE_RESET_NPC)
        msgbox(resetNPCIntro_text)

    }

    if(!flag(FLAG_RECEIVED_BERRY_7)) {

        msgbox(resetNPCNothingToReset_text)

    }
    else {

        msgbox("What would you like to reset?\n(Press B to exit)")

        if(flag(FLAG_RECEIVED_BERRY_7_2)) {

            dynmultipush("Reset Berries", 0)

        }
        else {

            dynmultipush("Reset Berry", 0)

        }


        dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

        if (var(VAR_RESULT) == 127) {

            msgbox("Come back if you would ever\nlike to reset your actions!")

        }
        else {

            msgbox("One moment while I reset your actions.", MSGBOX_AUTOCLOSE)
            fadescreen(FADE_TO_BLACK)
            call(ResetBerry_7)
            fadescreen(FADE_FROM_BLACK)
            msgbox("Your actions have been reset!")

        }

    }

    releaseall
    end

}

script ResetBerry_7 {

    clearflag(FLAG_RECEIVED_BERRY_7)
    clearflag(FLAG_RECEIVED_BERRY_7_2)
    removeitemfrommon(0)
    removeitemfrommon(1)
    removeitem(VAR_BATTLE7_BERRY)
    removeitem(VAR_BATTLE7_BERRY_2)
    setvar(VAR_BATTLE7_BERRY, 0)
    setvar(VAR_BATTLE7_BERRY_2, 0)

}

script ShuckleIslandShuckleHideout_B2F_EventScript_hintNPC7 {

    lockall
    faceplayer

    if(!flag(FLAG_SPOKE_HINT_NPC)) {

        setflag(FLAG_SPOKE_HINT_NPC)
        msgbox(hintNPCIntro_text)

    }

    msgbox("Now then, what hints can I offer you?\n(Press B to exit)")

    if (!flag(FLAG_READ_HINT_INFO)) {

        dynmultipush("About Hints (read me!)", 0)

    }
    else {

        dynmultipush("About Hints", 0)

    }

    dynmultipush("Small Hint", 1)

    if (!flag(FLAG_LAST_STAND_TRIGGERED)) {

        dynmultipush("Medium Hint", 2)
        dynmultipush("Large Hint", 3)

        if (flag(FLAG_SM_HINT_BATTLE_7) && flag(FLAG_MED_HINT_BATTLE_7) && flag(FLAG_LRG_HINT_BATTLE_7)) {

            dynmultipush("Solution", 4)

        }

    }

    if (flag(FLAG_LAST_STAND_TRIGGERED)) {

        dynmultipush("Small Hint 2", 5)
        dynmultipush("Medium Hint 2", 6)
        dynmultipush("Large Hint 2", 7)

        if (flag(FLAG_SM_HINT_BATTLE_7_2) && flag(FLAG_MED_HINT_BATTLE_7_2) && flag(FLAG_LRG_HINT_BATTLE_7_2)) {

            dynmultipush("Solution 2", 8)

        }

    }

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

            msgbox(hintNPCRefusedHint_text)

        }
    elif(var(VAR_RESULT) == 0) {

        msgbox(hintNPCAboutHints_text)
        setflag(FLAG_READ_HINT_INFO)

    }
    elif(var(VAR_RESULT) == 1) {

        msgbox(hintNPCBattle7SmallHint_text)

        if (!flag(FLAG_SM_HINT_BATTLE_7)) {

            setflag(FLAG_SM_HINT_BATTLE_7)
            addvar(VAR_NUM_SMALL_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 2) {

        msgbox(hintNPCBattle7MedHint_text)

        if (!flag(FLAG_MED_HINT_BATTLE_7)) {

            setflag(FLAG_MED_HINT_BATTLE_7)
            addvar(VAR_NUM_MED_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 3) {

        msgbox(hintNPCBattle7LrgHint_text)

        if (!flag(FLAG_LRG_HINT_BATTLE_7)) {

            setflag(FLAG_LRG_HINT_BATTLE_7)
            addvar(VAR_NUM_LARGE_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 4) {

        if (!flag(FLAG_SOLUTION_BATTLE_7)) {

            msgbox(hintNPCSolution_text, MSGBOX_YESNO)

        }
        else {

            setvar(VAR_RESULT, 1)

        }

        if (var(VAR_RESULT) == 0) {

            msgbox("Understood.\pKeep trying, and come back\nif you feel you need the solution.")

        }
        elif(var(VAR_RESULT) == 1) {

            setvar(VAR_0x8000, MUGSHOT_BATTLE_7)
            callnative(DrawMugshot)
            msgbox("https://youtu.be/EvvD5ovwIUo")
            callnative(ClearMugshot)

            if (!flag(FLAG_SOLUTION_BATTLE_7)) {

                setflag(FLAG_SOLUTION_BATTLE_7)
                addvar(VAR_NUM_SOLUTIONS, 1)

            }

        }
        
    }
    elif(var(VAR_RESULT) == 5) {

        msgbox(hintNPCBattle7SmallHint2_text)

        if (!flag(FLAG_SM_HINT_BATTLE_7_2)) {

            setflag(FLAG_SM_HINT_BATTLE_7_2)
            addvar(VAR_NUM_SMALL_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 6) {

        msgbox(hintNPCBattle7MedHint2_text)

        if (!flag(FLAG_MED_HINT_BATTLE_7_2)) {

            setflag(FLAG_MED_HINT_BATTLE_7_2)
            addvar(VAR_NUM_MED_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 7) {

        msgbox(hintNPCBattle7LrgHint2_text)

        if (!flag(FLAG_LRG_HINT_BATTLE_7_2)) {

            setflag(FLAG_LRG_HINT_BATTLE_7_2)
            addvar(VAR_NUM_LARGE_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 8) {

        if (!flag(FLAG_SOLUTION_BATTLE_7_2)) {

            msgbox(hintNPCSolution_text, MSGBOX_YESNO)

        }
        else {

            setvar(VAR_RESULT, 1)

        }

        if (var(VAR_RESULT) == 0) {

            msgbox("Understood.\pKeep trying, and come back\nif you feel you need the solution.")

        }
        elif(var(VAR_RESULT) == 1) {

            setvar(VAR_0x8000, MUGSHOT_BATTLE_7_PART_2)
            callnative(DrawMugshot)
            msgbox("https://youtu.be/PNuuwXbzMTg")
            callnative(ClearMugshot)

            if (!flag(FLAG_SOLUTION_BATTLE_7_2)) {

                setflag(FLAG_SOLUTION_BATTLE_7_2)
                addvar(VAR_NUM_SOLUTIONS, 1)

            }

        }
        
    }

    releaseall
    end

}

script ShuckleIslandShuckleHideout_B2F_EventScript_NewMechNPC7 {
    
    lock
    faceplayer

    if(!flag(FLAG_SPOKE_NEW_MECH_NPC)) {

        setflag(FLAG_SPOKE_NEW_MECH_NPC)
        msgbox(newMechNPCIntro_text)

    }

    call(NewMechNPC7Choices)

    release
    end

}

script NewMechNPC7Choices {

    msgbox("Now then, what new mechanics do\nyou want explained? (Press B to exit)")

    dynmultipush("Second Abilities", 0)
    dynmultipush("Sated Belch", 1)
    dynmultipush("Shuckle's Abilities", 2)
    dynmultipush("Shuckle AI", 3)
    dynmultipush("Confusion", 4)

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        msgbox("Stop by if you ever want\nthe new mechanics explained again!")

    }
    elif (var(VAR_RESULT) == 0) {

        msgbox(secondAbilities_text)
        call(NewMechNPC7Choices)

    }
    elif (var(VAR_RESULT) == 1) {

        msgbox(satedBelch_text)
        call(NewMechNPC7Choices)

    }
    elif (var(VAR_RESULT) == 2) {

        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 3) {

        msgbox("Shuckle will always attack Snorlax\nwith its strongest viable move.")
        call(NewMechNPC7Choices)

    }
    elif (var(VAR_RESULT) == 4) {

        msgbox("Confusion lasts for 5 turns.\pConfused Pokémon always hit\nthemselves in confusion.")
        call(NewMechNPC7Choices)

    }

}

script ShuckleAbilityChoices {

    msgbox("Now then, which ability do you want\nexplained? (Press B to exit)")

    dynmultipush("Shed Skin", 0)
    dynmultipush("Clear Body", 1)
    dynmultipush("Extra Pressure", 2)
    dynmultipush("Soul Linker", 3)
    dynmultipush("Unlimited Power", 4)
    dynmultipush("Fully Charged", 5)
    dynmultipush("Second Wind", 6)
    dynmultipush("Wide Aim", 7)

    if (flag(FLAG_LAST_STAND_TRIGGERED)) {

        dynmultipush("Last Stand", 8)
        
    }

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        call(NewMechNPC7Choices)

    }
    elif (var(VAR_RESULT) == 0) {

        msgbox("Shed Skin now always triggers\nat the end of each turn.")
        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 1) {

        msgbox("Clear Body has no changes from\nits typical behavior.")
        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 2) {

        msgbox(extraPressure_text)
        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 3) {

        msgbox("If a Pokémon with Soul Linker KOs one\nenemy, it also KOs all other enemies.")
        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 4) {

        msgbox("Pokémon with Unlimited Power do not\nlose PP when attacking.")
        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 5) {

        msgbox("Pokémon with Fully Charged ignore\ncharge and recharge turns for moves.")
        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 6) {

        msgbox("Pokémon with Second Wind exclusively\nuse spread moves when below half HP.")
        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 7) {

        msgbox("Wide Aim prevents spread moves\nfrom being disabled.")
        call(ShuckleAbilityChoices)

    }
    elif (var(VAR_RESULT) == 8) {

        msgbox(lastStand_text)
        call(ShuckleAbilityChoices)

    }

}

script ShuckleIslandShuckleHideout_B2F_EventScript_ShuckleDmgCalc {
    
    lockall

    playse(SE_PC_ON)
    msgbox("LOADING SHUCKLE DAMAGE CALCULATOR\.")
    waitse
    
    call(ShuckleDmgCalcOptions)

    releaseall
    end

}

script ShuckleDmgCalcOptions {

    msgbox("For which attack are you interested in\nthe damage calcs?")

    if (!flag(FLAG_DMG_CALC_INFO_BATTLE_7)) {

        dynmultipush("Damage Calc Table Usage (new info!)", 0)

    }
    else {

        dynmultipush("Damage Calc Table Usage", 0)

    }
    
    dynmultipush("Rock Wrecker", 1)
    dynmultipush("Dynamic Punch", 2)
    dynmultipush("Diamond Storm", 3)

    if (flag(FLAG_LAST_STAND_TRIGGERED)) {

        dynmultipush("Natural Gift", 4)

    }

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        playse(SE_PC_OFF)
        msgbox(dmgCalcClose_text)
        waitse

    }
    elif (var(VAR_RESULT) == 0) {

        setflag(FLAG_DMG_CALC_INFO_BATTLE_7)
        msgbox(dmgCalcTableUsageBattle7_text)
        call(ShuckleDmgCalcOptions)

    }
    elif (var(VAR_RESULT) == 1) {

        msgbox("This table shows the damage done\nby Shuckle to Snorlax.")
        closemessage
        displayshucklerockwreckerdmgcalc()
        waitbbuttonpress
        call(ShuckleDmgCalcOptions)

    }
    elif (var(VAR_RESULT) == 2) {

        msgbox("This table shows the damage done\nby Shuckle to Snorlax.")
        closemessage
        displayshuckledynamicpunchdmgcalc()
        waitbbuttonpress
        call(ShuckleDmgCalcOptions)

    }
    elif (var(VAR_RESULT) == 3) {

        closemessage
        displayshucklediamondstormdmgcalc()
        waitbbuttonpress
        call(ShuckleDmgCalcOptions)

    }
    elif (var(VAR_RESULT) == 4) {

        msgbox("This table shows the damage done\nto Shuckle by Snorlax's Natural Gift.")
        closemessage
        displayshucklenaturalgiftdmgcalc()
        waitbbuttonpress
        call(ShuckleDmgCalcOptions)

    }

}

script ShuckleIslandShuckleHideout_B2F_EventScript_Battle7Approach1 {

    lock
    
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_up * 4, walk_right * 2, face_up))
    waitmovement

    release
    call(ShuckleIslandShuckleHideout_B2F_EventScript_Battle7Intro)

    end

}

