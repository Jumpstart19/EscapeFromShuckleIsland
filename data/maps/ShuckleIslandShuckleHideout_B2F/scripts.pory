script ShuckleIslandShuckleHideout_B2F_EventScript_Battle7Intro {

    lock

    msgbox(giovanni7_1_text)
    waitmessage
    closemessage

    applymovement(GIOVANNI_FINAL_ID, moves(face_up, delay_16 * 4, face_down, delay_16 * 2))
    waitmovement

    msgbox(giovanni7_2_text)
    waitmessage

    setflag(FLAG_CLEAR_PETREL_BATTLE_6)
    clearflag(FLAG_CLEAR_BATTLE_7_NPCS)
    setrespawn(HEAL_LOCATION_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_B2F_2)

    release
    call(ShuckleIslandShuckleHideout_B2F_EventScript_ContinueBattle7)

    end

}

script ShuckleIslandShuckleHideout_B2F_EventScript_ContinueBattle7 {

    lock
    faceplayer

    setvar(VAR_STARTING_FIELD_EFFECT, STARTING_STATUS_NONE)
    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_B2F_STATE, 1)
    trainerbattle_single(TRAINER_GIOVANNI_2, Battle7_Intro_text, Battle7_Lose_text, ShuckleIslandShuckleHideout_B2F_EventScript_PostBattle7)


    release
    end

}

script ShuckleIslandShuckleHideout_B2F_EventScript_PostBattle7 {

    lock

    msgbox(giovanni_loss_text)
    waitmessage
    closemessage

    special(HealPlayerParty)

    setflag(FLAG_CLEAR_BATTLE_7_NPCS)
    setflag(FLAG_WON_BATTLE_7)
    clearflag(FLAG_RECEIVED_SURFBOARD)

    fadescreen(FADE_TO_BLACK)
    removeobject(SHUCKLE_SHINY_1_ID)
    removeobject(SHUCKLE_SHINY_2_ID)
    removeobject(GIOVANNI_FINAL_ID)
    removeobject(SHUCKLE_GRUNT_MIMIC_ID)
    removeobject(SHUCKLE_3_ID)
    removeobject(SHUCKLE_4_ID)
    removeobject(SHUCKLE_7_ID)
    removeobject(SHUCKLE_GRUNT_ID)
    removeobject(GRUNT_F_SHUCKLE_MIMIC_ID)
    addobject(SURFBOARD_ID)
    playse(SE_EXIT)
    waitse
    fadescreen(FADE_FROM_BLACK)

    release
    end

}

script ShuckleIslandShuckleHideout_B2F_EventScript_Surfboard {

    lockall
    giveitem(ITEM_SURF_TOOL, 1)
    removeobject(SURFBOARD_ID)
    setflag(FLAG_RECEIVED_SURFBOARD)
    releaseall
    end

}

