mapscripts ShuckleIslandShuckleHideout_B2F_MapScripts {

    MAP_SCRIPT_ON_FRAME_TABLE [
        
        VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_B2F_STATE, 1: ShuckleIslandShuckleHideout_B2F_EventScript_battle7Failed

    ]

}

const SHUCKLE_DMG_CALC_ID = 1
const SHUCKLE_SHINY_1_ID = 2
const SHUCKLE_SHINY_2_ID = 3
const GIOVANNI_FINAL_ID = 4
const SHUCKLE_1_ID = 5
const SHUCKLE_2_ID = 6
const SHUCKLE_GRUNT_MIMIC_ID = 7
const SHUCKLE_3_ID = 8
const SHUCKLE_4_ID = 9
const PETREL_BATTLE_7_ID = 10
const RESET_NPC_BATTLE_7_ID = 11
const HINT_NPC_BATTLE_7_ID = 12
const NEW_MECH_NPC_BATTLE_7_ID = 13
const SHUCKLE_GRUNT_ID = 14
const SHUCKLE_5_ID = 15
const SHUCKLE_6_ID = 16
const GRUNT_F_SHUCKLE_MIMIC_ID = 17
const SHUCKLE_7_ID = 18
const SURFBOARD_ID = 19

script ShuckleIslandShuckleHideout_B2F_EventScript_battle7Failed {

    lock

    indexspeciesinparty(SPECIES_SNORLAX)
    copyvar(VAR_TEMP_B, VAR_RESULT)
    if (var(VAR_TEMP_B) != 7) {

        setsnorlax2(VAR_TEMP_B)

    }

    if (!flag(0x521)) {

        if (!flag(FLAG_LEARNED_ULTIMATE_MOVES)) {

            applymovement(RESET_NPC_BATTLE_7_ID, moves(emote_exclamation_mark))
            playse(SE_PIN)
            waitse

            msgbox(battle7MissingMoves_text)
            waitmessage
            closemessage

            delay(60)

        }

        if (!flag(FLAG_BATTLE_7_HINT_NPC_TEXT)) {

            applymovement(HINT_NPC_BATTLE_7_ID, moves(walk_down, face_left))
            waitmovement
            applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
            waitmovement
            msgbox(hintNPC7message_text)
            waitmessage

            applymovement(HINT_NPC_BATTLE_7_ID, moves(walk_up, face_down))
            waitmovement
            applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
            waitmovement
            
            setflag(FLAG_BATTLE_7_HINT_NPC_TEXT)

        }

        if (flag(FLAG_LAST_STAND_TRIGGERED) && !flag(FLAG_BATTLE_7_RESET_NPC_TEXT)) {

            
            applymovement(RESET_NPC_BATTLE_7_ID, moves(emote_exclamation_mark))
            playse(SE_PIN)
            waitse

            msgbox(battle7NewOptions_text)
            waitmessage
            closemessage

            setflag(FLAG_BATTLE_7_RESET_NPC_TEXT)

        }

        removeitemfrommon(0)
        removeitemfrommon(1)
        removeitem(VAR_BATTLE7_BERRY)
        giveitemnojingle(VAR_BATTLE7_BERRY)
        removeitem(VAR_BATTLE7_BERRY_2)
        giveitemnojingle(VAR_BATTLE7_BERRY_2)

    }

    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_B2F_STATE, 2)
    release
    end

}

script ShuckleIslandShuckleHideout_B2F_EventScript_ShuckleCry {

    lock
    playmoncry(SPECIES_SHUCKLE, CRY_MODE_NORMAL)
    waitmoncry
    release
    end

}

