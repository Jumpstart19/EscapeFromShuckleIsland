mapscripts ShuckleIsland_MapScripts {

    MAP_SCRIPT_ON_FRAME_TABLE [

        VAR_SHUCKLE_ISLAND_STATE, 0: ShuckleIsland_EventScript_getMunchlax
        VAR_SHUCKLE_ISLAND_STATE, 2: ShuckleIsland_EventScript_setBattle1NPCs
        VAR_SHUCKLE_ISLAND_STATE, 4: ShuckleIsland_EventScript_setBattle2NPCs

    ]

    MAP_SCRIPT_ON_TRANSITION : ShuckleIsland_EventScript_setBattle1NPCs
    MAP_SCRIPT_ON_LOAD : ShuckleIsland_EventScript_setBattle2NPCs

}

const MUNCHLAX_ID = 1
const FATMAN_ID = 2
const BERRY_MAN_ID = 3
const TM_MERCHANT_ID = 4
const RESET_ID = 5
const LIL_BRO_ID = 6
const BIG_BRO_ID = 7
const HINT_ID = 8
const NEW_MECH_ID = 9
const BERRY_MAN_CUTSCENE_ID = 10
const FOCUS_PUNCH_ID = 11
const TWIN_AMY_ID = 12
const TWIN_LIV_ID = 13
const LIL_BRO2_ID = 14
const BIG_BRO2_ID = 15
const BERRY_MAN2_ID = 16
const RESET2_ID = 17
const HINT2_ID = 18


script ShuckleIsland_EventScript_getMunchlax{

    lockall
    setrespawn(HEAL_LOCATION_SHUCKLE_ISLAND_BATTLE_1)
    msgbox(format("You awaken on a strange island."), MSGBOX_AUTOCLOSE)
    waitmessage
    playmoncry(SPECIES_MUNCHLAX, CRY_MODE_NORMAL)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    waitmoncry
    applymovement(MUNCHLAX_ID, moves(walk_fast_left * 13, face_player))
    waitmovement
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_left))
    applymovement(MUNCHLAX_ID, moves(emote_exclamation_mark, delay_16 * 4))
    playse(SE_PIN)
    waitmovement
    applymovement(MUNCHLAX_ID, moves(walk_right * 3 face_down))
    waitmovement
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement
    msgbox(Munchlax_text)
    givemon(SPECIES_MUNCHLAX, 27, ITEM_NONE, ITEM_POKE_BALL, NATURE_IMPISH, 2, 0, 100, 0, 252, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_RECYCLE, MOVE_DEFENSE_CURL, MOVE_NONE, MOVE_NONE)
    removeobject(MUNCHLAX_ID)
    setflag(FLAG_RECEIVED_MUNCHLAX)
    setflag(FLAG_SYS_POKEMON_GET)
    setflag(FLAG_SYS_POKEDEX_GET)
    special(SetUnlockedPokedexFlags)
    setflag(FLAG_SYS_NATIONAL_DEX)
    special(EnableNationalPokedex)
    setvar(VAR_TEMP_1, 1)

    while(var(VAR_TEMP_1) <= 493) { // Loop through all Pokémon up to Arceus

        setseenmon(VAR_TEMP_1)
        addvar(VAR_TEMP_1, 1)

    }

    setvar(VAR_SHUCKLE_ISLAND_STATE, 1)
    setvar(VAR_NUM_SMALL_HINTS, 0)
    setvar(VAR_NUM_MED_HINTS, 0)
    setvar(VAR_NUM_LARGE_HINTS, 0)
    setvar(VAR_NUM_SOLUTIONS, 0)
    setflag(FLAG_SYS_B_DASH)
    setflag(FLAG_BADGE01_GET)
    setflag(FLAG_BADGE02_GET)
    setflag(FLAG_BADGE03_GET)
    setflag(FLAG_BADGE04_GET)
    setflag(FLAG_BADGE05_GET)
    setflag(FLAG_BADGE06_GET)
    setflag(FLAG_BADGE07_GET)
    setflag(FLAG_BADGE08_GET)
    setflag(FLAG_SETUP_BATTLE_1_NPCS)
    setflag(FLAG_SETUP_BATTLE_2_NPCS)
    setmetatile(44, 9, 0x2FC, TRUE)
    setmetatile(45, 9, 0x2FD, TRUE)
    setmetatile(44, 10, 0x0AB, TRUE)
    setmetatile(45, 10, 0x0AC, TRUE)
    special(DrawWholeMapView)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(format("Munchlax joined your party!"))
    waitfanfare
    closemessage
    applymovement(BERRY_MAN_CUTSCENE_ID, moves(walk_fast_left * 13, face_right, delay_16 * 2, face_left, delay_16 * 2, face_up, delay_16 * 2, walk_up * 4))
    waitmovement
    removeobject(BERRY_MAN_CUTSCENE_ID)
    releaseall
    end  

}

script ShuckleIsland_EventScript_setBattle1NPCs{

    if(!(flag(FLAG_STARTED_BATTLE_1))) {

        setflag(FLAG_SETUP_BATTLE_1_NPCS)

    }
    elif (flag(0x64E)) {

        setflag(FLAG_SETUP_BATTLE_1_NPCS)

    }
    else{

        clearflag(FLAG_SETUP_BATTLE_1_NPCS)
        clearflag(FLAG_WON_BATTLE_1A)
        cleartrainerflag(TRAINER_TIMMY)
        indexspeciesinparty(SPECIES_SHEDINJA)
        if (var(VAR_RESULT) == 0) {

            takemon(0)

        }
        elif (var(VAR_RESULT) == 1) {

            takemon(1)

        }

        removeitem(VAR_BATTLE1_BERRY)
        GiveItemToMon(0, VAR_BATTLE1_BERRY)

    }

    if (var(VAR_SHUCKLE_ISLAND_STATE) == 2) {

        setvar(VAR_SHUCKLE_ISLAND_STATE, 1)

    }

}

script ShuckleIsland_EventScript_Sign1{

    lock
    msgbox(Sign1_text, MSGBOX_SIGN)
    release
    end

}

script ShuckleIsland_EventScript_Sign2{

    lock
    msgbox(Sign2_text, MSGBOX_SIGN)
    release
    end

}

script ShuckleIsland_EventScript_fatMan{

    lock
    faceplayer
    msgbox(fatMan_text)
    release
    end

}

script ShuckleIsland_EventScript_berryGuy {

    lock
    faceplayer

    if(!flag(FLAG_SPOKE_BERRY_GUY_1)) {

        setflag(FLAG_SPOKE_BERRY_GUY_1)

        if(!flag(FLAG_SPOKE_TM_GUY_1)) {

            msgbox(berryGuyIntro_text)

        }
        else {

            msgbox(berryGuyShortIntro_text)

        }

    }

    if(!flag(FLAG_RECEIVED_BERRY_1)) {

        msgbox(berryGuyPresentOptions_text)

        dynmultipush("Liechi Berry", ITEM_LIECHI_BERRY)
        dynmultipush("Ganlon Berry", ITEM_GANLON_BERRY)
        dynmultipush("Salac Berry", ITEM_SALAC_BERRY)
        dynmultipush("Petaya Berry", ITEM_PETAYA_BERRY)
        dynmultipush("Apicot Berry", ITEM_APICOT_BERRY)
        dynmultipush("Lansat Berry", ITEM_LANSAT_BERRY)

        dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)

        if (var(VAR_RESULT) == 127) {

            msgbox("Come back when you know\nwhich berry you want!")

        }
        else {

            copyvar(VAR_BATTLE1_BERRY, VAR_RESULT)
            giveitem(VAR_BATTLE1_BERRY, 1)
            setflag(FLAG_RECEIVED_BERRY_1)

        }
    }
    else {

        msgbox("I hope you make good use of that berry!")

    }

    release
    end

}

script ShuckleIsland_EventScript_TMGuy {

    lockall
    faceplayer

    if(!flag(FLAG_SPOKE_TM_GUY_1)) {

        setflag(FLAG_SPOKE_TM_GUY_1)

        if(!flag(FLAG_SPOKE_BERRY_GUY_1)) {

            msgbox(TMGuyIntro_text)

        }
        else {

            msgbox(TMGuyShortIntro_text)

        }

    }

    if(!flag(FLAG_RECEIVED_TM_1)) {
        
        msgbox(TMGuyPresentOptions_text)
        
        dynmultipush("TM56 Fling", ITEM_TM56)
        dynmultipush("TM83 Natural Gift", ITEM_TM83)

        dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)

        if (var(VAR_RESULT) == 127) {

            msgbox("Come back when you know\nwhich TM you want!")

        }
        else {

            giveitem(VAR_RESULT, 1)
            setflag(FLAG_RECEIVED_TM_1)
            
        }
    }
    else {

        msgbox("Teach that TM to Munchlax and\ndefeat those brothers!")

    }

    releaseall
    end

}

script ShuckleIsland_EventScript_resetNPC {

    lockall
    faceplayer

    if(!flag(FLAG_SPOKE_RESET_NPC)) {

        setflag(FLAG_SPOKE_RESET_NPC)
        msgbox(resetNPCIntro_text)

    }

    if(!(flag(FLAG_RECEIVED_BERRY_1) || flag(FLAG_RECEIVED_TM_1))) {

        msgbox(resetNPCNothingToReset_text)

    }
    else {

        msgbox("What would you like to reset?\n(Press B to exit)")

        if(flag(FLAG_RECEIVED_BERRY_1)) {

            dynmultipush("Reset Berry", 0)

        }

        if(flag(FLAG_RECEIVED_TM_1)) {

            dynmultipush("Reset TM", 1)

        }

        if(flag(FLAG_RECEIVED_BERRY_1) && flag(FLAG_RECEIVED_TM_1)) {

            dynmultipush("Reset All", 2)

        }

        dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

        if (var(VAR_RESULT) == 127) {

            msgbox("Come back if you would ever\nlike to reset your actions!")

        }
        else {

            msgbox("One moment while I reset your actions.", MSGBOX_AUTOCLOSE)
            fadescreen(FADE_TO_BLACK)

            if(var(VAR_RESULT) == 0) {

                call(ResetBerry_1)

            }
            elif(var(VAR_RESULT) == 1) {

                call(ResetTM_1)

            }
            elif(var(VAR_RESULT) == 2) {

                call(ResetTM_1)
                call(ResetBerry_1)

            }

            fadescreen(FADE_FROM_BLACK)
            msgbox("Your actions have been reset!")

        }

    }

    releaseall
    end

}

script ShuckleIsland_EventScript_hintNPC {

    lockall
    faceplayer

    if(!flag(FLAG_SPOKE_HINT_NPC)) {

        setflag(FLAG_SPOKE_HINT_NPC)
        msgbox(hintNPCIntro_text)

    }

    msgbox("Now then, what hints can I offer you?\n(Press B to exit)")

    if (!flag(FLAG_READ_HINT_INFO)) {

        dynmultipush("About Hints (read me!)", 0)

    }
    else {

        dynmultipush("About Hints", 0)

    }

    dynmultipush("Small Hint", 1)
    dynmultipush("Medium Hint", 2)
    dynmultipush("Large Hint", 3)

    if (flag(FLAG_SM_HINT_BATTLE_1) && flag(FLAG_MED_HINT_BATTLE_1) && flag(FLAG_LRG_HINT_BATTLE_1)) {

        dynmultipush("Solution", 4)

    }

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

            msgbox(hintNPCRefusedHint_text)

        }
    elif(var(VAR_RESULT) == 0) {

        msgbox(hintNPCAboutHints_text)
        setflag(FLAG_READ_HINT_INFO)

    }
    elif(var(VAR_RESULT) == 1) {

        msgbox(hintNPCBattle1SmallHint_text)

        if (!flag(FLAG_SM_HINT_BATTLE_1)) {

            setflag(FLAG_SM_HINT_BATTLE_1)
            addvar(VAR_NUM_SMALL_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 2) {

        msgbox(hintNPCBattle1MedHint_text)

        if (!flag(FLAG_MED_HINT_BATTLE_1)) {

            setflag(FLAG_MED_HINT_BATTLE_1)
            addvar(VAR_NUM_MED_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 3) {

        msgbox(hintNPCBattle1LargeHint_text)

        if (!flag(FLAG_LRG_HINT_BATTLE_1)) {

            setflag(FLAG_LRG_HINT_BATTLE_1)
            addvar(VAR_NUM_LARGE_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 4) {

        if (!flag(FLAG_SOLUTION_BATTLE_1)) {

            msgbox(hintNPCSolution_text, MSGBOX_YESNO)

        }
        else {

            setvar(VAR_RESULT, 1)

        }

        if (var(VAR_RESULT) == 0) {

            msgbox("Understood.\pKeep trying, and come back\nif you feel you need the solution.")

        }
        elif(var(VAR_RESULT) == 1) {

            setvar(VAR_0x8000, MUGSHOT_BATTLE_1)
            callnative(DrawMugshot)
            msgbox("https://youtu.be/MW4LPPMXSjE")
            callnative(ClearMugshot)

            if (!flag(FLAG_SOLUTION_BATTLE_1)) {

                setflag(FLAG_SOLUTION_BATTLE_1)
                addvar(VAR_NUM_SOLUTIONS, 1)

            }

        }
        
    }

    releaseall
    end

}

script ShuckleIsland_EventScript_NewMechNPC {
    
    lockall
    faceplayer

    if(!flag(FLAG_SPOKE_NEW_MECH_NPC)) {

        setflag(FLAG_SPOKE_NEW_MECH_NPC)
        msgbox(newMechNPCIntro_text)

    }

    msgbox("Now then, what new mechanics do\nyou want explained? (Press B to exit)")

    dynmultipush("Skill Swap", 0)

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        msgbox("Stop by if you ever want\nthe new mechanics explained again!")

    }
    elif (var(VAR_RESULT) == 0) {

        msgbox("Skill Swap can now be used\nto swap the ability Wonder Guard.")

    }

    releaseall
    end

}

script ShuckleIsland_EventScript_Battle1a{

    if (!flag(FLAG_STARTED_BATTLE_1)) {

        setflag(FLAG_STARTED_BATTLE_1)
        clearflag(FLAG_SETUP_BATTLE_1_NPCS)
        trainerbattle_single(TRAINER_TIMMY, Battle1a_Intro_text, Battle1a_Lose_text, ShuckleIsland_EventScript_PostBattle1a)

    }
    else {

        trainerbattle_single(TRAINER_TIMMY, Battle1a_Intro_Short_text, Battle1a_Lose_text, ShuckleIsland_EventScript_PostBattle1a)

    }

}

script ShuckleIsland_EventScript_PostBattle1a {

    lockall
    special(HealPlayerParty)
    msgbox(Battle1a_PostBattle_text)
    givemon(SPECIES_SHEDINJA, 30, ITEM_CUSTAP_BERRY, ITEM_POKE_BALL, NATURE_BRAVE, 0, 2, 0, 252, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_BUG_BITE, MOVE_NONE, MOVE_NONE, MOVE_NONE)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("You received Timmy's Shedinja\.\nbut you don't feel great about it.")
    waitfanfare
    applymovement(LIL_BRO_ID, moves(walk_right, face_up))
    waitmovement
    msgbox(Battle1a_PostBattle2_text)
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
    applymovement(LIL_BRO_ID, moves(walk_fast_right * 8))
    msgbox("WAAAAAAH!")
    waitmovement
    removeobject(LIL_BRO_ID)
    setflag(FLAG_WON_BATTLE_1A)
    releaseall
    call(ShuckleIsland_EventScript_Battle1b)

}

script ShuckleIsland_EventScript_Battle1b {

    lockall
    applymovement(BIG_BRO_ID, moves(walk_down * 2, face_left))
    waitmovement
    setvar(VAR_SHUCKLE_ISLAND_STATE, 2)
    releaseall
    trainerbattle_single(TRAINER_JOHNNY, Battle1b_Intro_text, Battle1b_Lose_text, ShuckleIsland_EventScript_PostBattle1b)

}

script ShuckleIsland_EventScript_PostBattle1b {

    lockall
    special(HealPlayerParty)
    msgbox(Battle1b_PostBattle_text)
    indexspeciesinparty(SPECIES_SHEDINJA)
    if (var(VAR_RESULT) == 0) {

        takemon(0)

    }
    elif (var(VAR_RESULT) == 1) {

        takemon(1)

    }
    givemon(SPECIES_GALLADE, 28, ITEM_NONE, ITEM_POKE_BALL, NATURE_LONELY, 0, 0, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_SKILL_SWAP, MOVE_MIMIC, MOVE_NONE, MOVE_NONE)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox("You returned Timmy's Shedinja\nand received Johnny's Gallade!")
    waitfanfare
    applymovement(BIG_BRO_ID, moves(face_right))
    waitmovement
    msgbox("HEY TIMMY, I GOT YOUR SHEDINJA BACK!", MSGBOX_AUTOCLOSE)
    applymovement(BIG_BRO_ID, moves(walk_right * 3))
    waitmovement
    msgbox("I should probably teach him how to\nproperly choose held items sometime\.", MSGBOX_AUTOCLOSE)
    applymovement(BIG_BRO_ID, moves(walk_right * 5))
    waitmovement
    removeobject(BIG_BRO_ID)
    setflag(FLAG_WON_BATTLE_1B)
    setmetatile(44, 9, 0x2FC, TRUE)
    setmetatile(45, 9, 0x2FD, TRUE)
    setmetatile(44, 10, 0x0AB, TRUE)
    setmetatile(45, 10, 0x0AC, TRUE)
    special(DrawWholeMapView)
    setrespawn(HEAL_LOCATION_SHUCKLE_ISLAND_BATTLE_2)
    releaseall

}

script ShuckleIsland_EventScript_setBattle2NPCs{

    if(!(flag(FLAG_STARTED_BATTLE_2))) {

        setflag(FLAG_SETUP_BATTLE_2_NPCS)
        setmetatile(44, 9, 0x2FC, TRUE)
        setmetatile(45, 9, 0x2FD, TRUE)
        setmetatile(44, 10, 0x0AB, TRUE)
        setmetatile(45, 10, 0x0AC, TRUE)
        special(DrawWholeMapView)

    }
    elif (flag(0x6E1)) {

        setflag(FLAG_SETUP_BATTLE_2_NPCS)

    }
    else{

        clearflag(FLAG_SETUP_BATTLE_2_NPCS)
        removeitemfrommon(0)
        removeitemfrommon(1)
        removeitem(VAR_BATTLE2_BERRY)
        giveitemnojingle(VAR_BATTLE2_BERRY, 1)
        setmetatile(44, 9, 0x2FC, TRUE)
        setmetatile(45, 9, 0x2FD, TRUE)
        setmetatile(44, 10, 0x0AB, TRUE)
        setmetatile(45, 10, 0x0AC, TRUE)
        special(DrawWholeMapView)

    }

    if (var(VAR_SHUCKLE_ISLAND_STATE) == 4) {

        setvar(VAR_SHUCKLE_ISLAND_STATE, 3)

    }

}

script ShuckleIsland_EventScript_FocusPunchTutor {

    lock

    if(!flag(FLAG_SPOKE_FOCUS_PUNCH_TUTOR)) {

        setflag(FLAG_SPOKE_FOCUS_PUNCH_TUTOR)
        msgbox(FocusPunchTutorIntro1_text)
        faceplayer
        msgbox(FocusPunchTutorIntro2_text)

    }

    if(!flag(FLAG_FOCUS_PUNCH)) {

        faceplayer
        msgbox("Now then, should I teach Focus Punch\nto one of your Pokémon?", MSGBOX_YESNO)

        if (var(VAR_RESULT) == YES) {

            msgbox("Alright, which Pokémon\nshould learn Focus Punch?")
            setvar(VAR_0x8005, MOVE_FOCUS_PUNCH)
            special(ChooseMonForMoveTutor)
            waitstate

            if (var(VAR_RESULT) == 0) {

                msgbox("Alright, well you know where to find me\nif you change your mind.\pNot like we're going anywhere\.")

            }
            else {

                setflag(FLAG_FOCUS_PUNCH)
                msgbox("Now give those girls a solid punching!\pEr\.I mean their Pokémon\.")

            }

        }
        else {

            msgbox("Alright, well you know where to find me\nif you change your mind.\pNot like we're going anywhere\.")

        }

    }
    elif(flag(FLAG_WON_BATTLE_2)) {

        faceplayer
        msgbox(FocusPunchTutorPostBattle2_text)

    }
    else{

        faceplayer
        msgbox("Now give those girls a solid punching!\pEr\.I mean their Pokémon\.")

    }

    applymovement(FOCUS_PUNCH_ID, moves(face_right))
    release
    end

}

