script ShuckleIslandShuckleHideout_1F_EventScript_Petrel {

    lock
    faceplayer

    if (!flag(FLAG_WON_BATTLE_6)) {

        if (!flag(FLAG_PETREL_PRE_BATTLE_6)) {

            msgbox(petrelBattle6Intro_text)
            setflag(FLAG_PETREL_PRE_BATTLE_6)

        }

        if(!flag(FLAG_RECEIVED_BERRY_6)) {

            msgbox(berryGuyPresentOptions_text)

            dynmultipush("Occa Berry", ITEM_OCCA_BERRY)
            dynmultipush("Passho Berry", ITEM_PASSHO_BERRY)
            dynmultipush("Wacan Berry", ITEM_WACAN_BERRY)
            dynmultipush("Rindo Berry", ITEM_RINDO_BERRY)
            dynmultipush("Yache Berry", ITEM_YACHE_BERRY)
            dynmultipush("Chople Berry", ITEM_CHOPLE_BERRY)
            dynmultipush("Kebia Berry", ITEM_KEBIA_BERRY)
            dynmultipush("Shuca Berry", ITEM_SHUCA_BERRY)
            dynmultipush("Coba Berry", ITEM_COBA_BERRY)
            dynmultipush("Payapa Berry", ITEM_PAYAPA_BERRY)
            dynmultipush("Tanga Berry", ITEM_TANGA_BERRY)
            dynmultipush("Charti Berry", ITEM_CHARTI_BERRY)
            dynmultipush("Kasib Berry", ITEM_KASIB_BERRY)
            dynmultipush("Haban Berry", ITEM_HABAN_BERRY)
            dynmultipush("Colbur Berry", ITEM_COLBUR_BERRY)
            dynmultipush("Babiri Berry", ITEM_BABIRI_BERRY)
            dynmultipush("Chilan Berry", ITEM_CHILAN_BERRY)

            dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)

            if (var(VAR_RESULT) == 127) {

                msgbox("So, I guess you're resigned to\nlosing to Big Blue then?\pNot that I think a single berry would\nhave made much of a difference.")

            }
            else {

                copyvar(VAR_BATTLE6_BERRY, VAR_RESULT)
                giveitem(VAR_BATTLE6_BERRY, 1)
                setflag(FLAG_RECEIVED_BERRY_6)

            }
        }
        else {

            msgbox("I hope you chose the right berry\nfor your sake, kid.")

        }

    }
    else {

        if (!flag(FLAG_PETREL_PRE_BATTLE_7)) {

            msgbox(petrelBattle7Intro_text)
            setflag(FLAG_PETREL_PRE_BATTLE_7)

        }

        if(!flag(FLAG_RECEIVED_BERRY_7)) {

            msgbox(berryGuyPresentOptions_text)

            dynmultipush("Occa Berry", ITEM_OCCA_BERRY)
            dynmultipush("Passho Berry", ITEM_PASSHO_BERRY)
            dynmultipush("Wacan Berry", ITEM_WACAN_BERRY)
            dynmultipush("Rindo Berry", ITEM_RINDO_BERRY)
            dynmultipush("Yache Berry", ITEM_YACHE_BERRY)
            dynmultipush("Chople Berry", ITEM_CHOPLE_BERRY)
            dynmultipush("Kebia Berry", ITEM_KEBIA_BERRY)
            dynmultipush("Shuca Berry", ITEM_SHUCA_BERRY)
            dynmultipush("Coba Berry", ITEM_COBA_BERRY)
            dynmultipush("Payapa Berry", ITEM_PAYAPA_BERRY)
            dynmultipush("Tanga Berry", ITEM_TANGA_BERRY)
            dynmultipush("Charti Berry", ITEM_CHARTI_BERRY)
            dynmultipush("Kasib Berry", ITEM_KASIB_BERRY)
            dynmultipush("Haban Berry", ITEM_HABAN_BERRY)
            dynmultipush("Colbur Berry", ITEM_COLBUR_BERRY)
            dynmultipush("Babiri Berry", ITEM_BABIRI_BERRY)
            dynmultipush("Chilan Berry", ITEM_CHILAN_BERRY)

            dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_SHOW_ITEM)

            if (var(VAR_RESULT) == 127) {

                msgbox("I don't blame you. I doubt a single\nberry would make a difference.")

            }
            else {

                copyvar(VAR_BATTLE7_BERRY, VAR_RESULT)
                giveitem(VAR_BATTLE7_BERRY, 1)
                setflag(FLAG_RECEIVED_BERRY_7)

            }
        }
        else {

            msgbox("I'd say good luck, but you don't realize\nwhat you're going up against.\pYou don't stand a chance.")

        }

    }

    release
    end

}

