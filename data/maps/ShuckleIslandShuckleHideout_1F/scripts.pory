script ShuckleIslandShuckleHideout_1F_EventScript_PeripheralGrunt {

    lockall

    specialvar(VAR_TEMP_6, GetPlayerFacingDirection)
    if (var(VAR_TEMP_6) == DIR_NORTH) {

        msgbox("The grunt strains to only look at you\nfrom the corners of his eyes.\pHis eyes are completely bugging out.")

    }
    elif (var(VAR_TEMP_6) == DIR_SOUTH) {

        msgbox("The grunt strains to look at you\nfrom the corners of his eyes.\pHe's failing, and he knows it.")

    }
    else {

        msgbox(peripheral_text)

    }

    releaseall
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_WarpPanelGrunt {

    lockall

    msgbox(warpPanelGrunt_text)
    waitmessage
    closemessage

    applymovement(GRUNT_M_WARP_ID, moves(walk_left * 3))
    delay(30)
    fadescreen(FADE_TO_BLACK)
    delay(30)
    playse(SE_WARP_IN)
    waitse
    setflag(FLAG_WARP_PANEL_GRUNT)
    removeobject(GRUNT_M_WARP_ID)
    delay(30)
    fadescreen(FADE_FROM_BLACK)

    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 3)

    releaseall
    end

}

