script ShuckleIslandShuckleHideout_1F_EventScript_HariyamaDmgCalc {
    
    lockall

    playse(SE_PC_ON)
    msgbox("LOADING HARIYAMA DAMAGE CALCULATOR\.")
    waitse

    call(HariyamaDmgCalcOptions)

    releaseall
    end

}

script HariyamaDmgCalcOptions {

    msgbox(hariyamaDmgCalcIntro_text)

    dynmultipush("Snorlax", 0)
    dynmultipush("Gallade", 1)

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        playse(SE_PC_OFF)
        msgbox(dmgCalcClose_text)
        waitse

    }
    elif (var(VAR_RESULT) == 0) {

        closemessage
        displayhariyamasnorlaxdmgcalc()
        waitbbuttonpress
        call(HariyamaDmgCalcOptions)

    }
    elif (var(VAR_RESULT) == 1) {

        closemessage
        displayhariyamagalladedmgcalc()
        waitbbuttonpress
        call(HariyamaDmgCalcOptions)

    }

}

