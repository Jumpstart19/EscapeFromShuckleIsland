mapscripts ShuckleIslandShuckleHideout_1F_MapScripts {

    MAP_SCRIPT_ON_FRAME_TABLE [
        
        VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 0: ShuckleIslandShuckleHideout_1F_EventScript_inCell
        VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 100: ShuckleIslandShuckleHideout_1F_EventScript_setSnorlax2
        VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 200: ShuckleIslandShuckleHideout_1F_EventScript_battle6Failed

    ]

}

