const GRUNT_M_BATTLE_5_CONTINUE_ID = 14
const GRUNT_M_HAZING_ID = 15
const GRUNT_F_HAZING_ID = 16
const GRUNT_F_BLACK_PAINT_ID = 17
const PETREL_BATTLE_6_NPC_ID = 18
const MOVE_TUTOR_NPC_BATTLE_6_ID = 19
const RESET_NPC_BATTLE_6_ID = 20
const HINT_NPC_BATTLE_6_ID = 21
const NEW_MECH_NPC_BATTLE_6_ID = 22
const BERRY_1_ID = 23
const BERRY_2_ID = 24
const BERRY_3_ID = 25
const BERRY_4_ID = 26
const BERRY_5_ID = 27
const BERRY_6_ID = 28
