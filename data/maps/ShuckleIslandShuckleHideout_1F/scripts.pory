script ShuckleIslandShuckleHideout_1F_EventScript_inCell {

    lockall
    msgbox("You're brought to a\.prison cell?")
    waitmessage
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
    waitmovement
    applymovement(GRUNT_M_BATTLE_5_CONTINUE_ID, moves(walk_down * 1))
    waitmovement
    msgbox(hideoutIntro_text)
    waitmessage
    closemessage
    applymovement(GRUNT_M_BATTLE_5_CONTINUE_ID, moves(walk_up * 2, face_down))
    waitmovement
    setmetatile(58, 12, 0x259, TRUE)
    special(DrawWholeMapView)
    playse(SE_SWITCH)
    waitse
    clearflag(FLAG_CLEAR_CELL_DOOR)
    addobject(CELL_DOOR_ID)
    delay(40)
    applymovement(GRUNT_M_BATTLE_5_CONTINUE_ID, moves(walk_up * 4))
    waitmovement
    setflag(FLAG_CLEAR_INTRO_GRUNT)
    removeobject(GRUNT_M_BATTLE_5_CONTINUE_ID)

    indexspeciesinparty(SPECIES_GALLADE)
    copyvar(VAR_TEMP_B, VAR_RESULT)

    if (var(VAR_TEMP_B) == 0) {

        setmonmoves(0, MOVE_GRUDGE, MOVE_NONE, MOVE_NONE, MOVE_NONE)
        setmonmoves(1, MOVE_STOCKPILE, MOVE_SWALLOW, MOVE_NONE, MOVE_NONE)

    }
    else {

        setmonmoves(1, MOVE_GRUDGE, MOVE_NONE, MOVE_NONE, MOVE_NONE)
        setmonmoves(0, MOVE_STOCKPILE, MOVE_SWALLOW, MOVE_NONE, MOVE_NONE)

    }
    
    special(HealPlayerParty)
    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 1)
    releaseall
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_setSnorlax2 {

    lock
    indexspeciesinparty(SPECIES_SNORLAX)
    copyvar(VAR_TEMP_B, VAR_RESULT)
    if (var(VAR_TEMP_B) != 7) {

        setsnorlax2(VAR_TEMP_B)

    }
    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 1)
    release
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_battle6Failed {

    lock
    indexspeciesinparty(SPECIES_SNORLAX)
    copyvar(VAR_TEMP_B, VAR_RESULT)
    if (var(VAR_TEMP_B) != 7) {

        setsnorlax2(VAR_TEMP_B)

    }
    if (!flag(FLAG_BATTLE_6_HINT_NPC_TEXT)) {

        applymovement(HINT_NPC_BATTLE_6_ID, moves(walk_down, face_left))
        waitmovement
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_right))
        waitmovement
        msgbox(hintNPC6message_text)
        waitmessage

        applymovement(HINT_NPC_BATTLE_6_ID, moves(walk_up, face_down))
        waitmovement
        applymovement(OBJ_EVENT_ID_PLAYER, moves(face_up))
        waitmovement
        
        setflag(FLAG_BATTLE_6_HINT_NPC_TEXT)

    }
    removeitemfrommon(0)
    removeitemfrommon(1)
    removeitem(VAR_BATTLE6_BERRY)
    giveitemnojingle(VAR_BATTLE6_BERRY)
    if (flag(FLAG_RECEIVED_SITRUS_BERRY)) {

        removeitem(ITEM_SITRUS_BERRY)
        giveitemnojingle(ITEM_SITRUS_BERRY)

    }
    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 20)
    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_B1F_STATE, 1)
    release
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_cellSign {

    lockall
    if (!flag(FLAG_STARTED_BATTLE_5)) {

        msgbox(cellSign_text, MSGBOX_SIGN)

    }
    else {

        msgbox(cellSign2_text, MSGBOX_SIGN)

    }
    setflag(FLAG_READ_CELL_SIGN)
    releaseall
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_cellDoor {

    lockall
    
    if (!flag(FLAG_READ_CELL_SIGN)) {

        msgbox(cellDoorNoSign_text)

    }
    else {

        msgbox(cellDoor1_text, MSGBOX_YESNO)
        if (var(VAR_RESULT) == YES) {

            playse(SE_M_FLATTER)
            waitse
            msgbox(cellDoor2_text, MSGBOX_YESNO)
            if (var(VAR_RESULT) == YES) {

                playse(SE_M_FLATTER)
                waitse
                msgbox(cellDoor3_text, MSGBOX_YESNO)
                if (var(VAR_RESULT) == YES) {

                    playse(SE_M_FLATTER)
                    waitse
                    msgbox(cellDoor4_text)
                    waitmessage
                    closemessage
                    playse(SE_PIN)
                    waitse
                    clearflag(FLAG_CLEAR_BATTLE_5_START_GRUNT)
                    addobject(GRUNT_M_BATTLE_5_START_ID)
                    applymovement(GRUNT_M_BATTLE_5_START_ID, moves(walk_fast_left * 12, walk_fast_down *1))
                    waitmovement
                    msgbox("What's going on in here?")
                    waitmessage
                    closemessage
                    setflag(FLAG_CLEAR_CELL_DOOR)
                    removeobject(CELL_DOOR_ID)
                    setmetatile(58, 12, 0x228, FALSE)
                    special(DrawWholeMapView)
                    playse(SE_SWITCH)
                    waitse
                    applymovement(GRUNT_M_BATTLE_5_START_ID, moves(emote_exclamation_mark, delay_16 * 4))
                    playse(SE_PIN)
                    waitmovement
                    applymovement(GRUNT_M_BATTLE_5_START_ID, moves(walk_down *1))
                    waitmovement
                    msgbox(battle5Grunt_text)
                    waitmessage
                    setflag(FLAG_STARTED_BATTLE_5)
                    clearflag(FLAG_CLEAR_BATTLE_5_NPCS)
                    setflag(FLAG_CLEAR_BATTLE_5_START_GRUNT)
                    clearflag(FLAG_CLEAR_INTRO_GRUNT)
                    addobject(GRUNT_M_BATTLE_5_CONTINUE_ID)
                    removeobject(GRUNT_M_BATTLE_5_START_ID)
                    setrespawn(HEAL_LOCATION_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_3)
                    indexspeciesinparty(SPECIES_SNORLAX)
                    copyvar(VAR_TEMP_B, VAR_RESULT)
                    if (var(VAR_TEMP_B) != 7) {

                        setsnorlax2(VAR_TEMP_B)

                    }
                    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 100)
                    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_2, battle5Intro_text, battle5Lose_text, ShuckleIslandShuckleHideout_1F_EventScript_PostBattle5)

                }
                else {

                    msgbox(cellDoorNo3_text)

                }

            }
            else {

                msgbox(cellDoorNo2_text)

            }

        }
        else {

            msgbox(cellDoorNo1_text)

        }

    }

    releaseall
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_ContinueBattle5 {

    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 100)
    trainerbattle_single(TRAINER_GRUNT_AQUA_HIDEOUT_2, battle5IntroShort_text, battle5Lose_text, ShuckleIslandShuckleHideout_1F_EventScript_PostBattle5)

}

script ShuckleIslandShuckleHideout_1F_EventScript_PostBattle5 {

    lockall

    setflag(FLAG_CLEAR_BATTLE_5_NPCS)
    setflag(FLAG_CLEAR_INTRO_GRUNT)

    msgbox(postBattle5_1_text)
    waitmessage
    closemessage

    applymovement(GRUNT_M_BATTLE_5_CONTINUE_ID, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitse

    msgbox(postBattle5_2_text)
    waitmessage
    closemessage

    applymovement(GRUNT_M_BATTLE_5_CONTINUE_ID, moves(walk_fast_up, walk_fast_left * 7, walk_fast_down * 10))
    waitmovement

    removeobject(GRUNT_M_BATTLE_5_CONTINUE_ID)
    removeobject(HARIYAMA_DAMAGE_CALC_ID)

    setmetatile(9, 6, 0x31C, TRUE)
    setmetatile(10, 6, 0x31D, TRUE)
    setmetatile(11, 6, 0x31E, TRUE)
    special(DrawWholeMapView)
    setflag(FLAG_CLEAR_BATTLE_6_NPCS)
    special(HealPlayerParty)
    setrespawn(HEAL_LOCATION_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_2)

    releaseall
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_hintNPC5 {

    lock
    faceplayer

    if(!flag(FLAG_SPOKE_HINT_NPC)) {

        setflag(FLAG_SPOKE_HINT_NPC)
        msgbox(hintNPCIntro_text)

    }

    msgbox("Now then, what hints can I offer you?\n(Press B to exit)")

    if (!flag(FLAG_READ_HINT_INFO)) {

        dynmultipush("About Hints (read me!)", 0)

    }
    else {

        dynmultipush("About Hints", 0)

    }
    
    dynmultipush("Small Hint", 1)
    dynmultipush("Medium Hint", 2)

    if (flag(FLAG_SM_HINT_BATTLE_5) && flag(FLAG_MED_HINT_BATTLE_5)) {

        dynmultipush("Solution", 3)

    }

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

            msgbox(hintNPCRefusedHint_text)

        }
    elif(var(VAR_RESULT) == 0) {

        msgbox(hintNPCAboutHints_text)
        setflag(FLAG_READ_HINT_INFO)

    }
    elif(var(VAR_RESULT) == 1) {

        msgbox(hintNPCBattle5SmallHint_text)

        if (!flag(FLAG_SM_HINT_BATTLE_5)) {

            setflag(FLAG_SM_HINT_BATTLE_5)
            addvar(VAR_NUM_SMALL_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 2) {

        msgbox(hintNPCBattle5MedHint_text)

        if (!flag(FLAG_MED_HINT_BATTLE_5)) {

            setflag(FLAG_MED_HINT_BATTLE_5)
            addvar(VAR_NUM_MED_HINTS, 1)

        }

    }
    elif(var(VAR_RESULT) == 3) {

        if (!flag(FLAG_SOLUTION_BATTLE_5)) {

            msgbox(hintNPCSolution_text, MSGBOX_YESNO)

        }
        else {

            setvar(VAR_RESULT, 1)

        }

        if (var(VAR_RESULT) == 0) {

            msgbox("Understood.\pKeep trying, and come back\nif you feel you need the solution.")

        }
        elif(var(VAR_RESULT) == 1) {

            setvar(VAR_0x8000, MUGSHOT_BATTLE_5)
            callnative(DrawMugshot)
            msgbox("https://youtu.be/wzfsDlxxXwY")
            callnative(ClearMugshot)

            if (!flag(FLAG_SOLUTION_BATTLE_5)) {

                setflag(FLAG_SOLUTION_BATTLE_5)
                addvar(VAR_NUM_SOLUTIONS, 1)

            }

        }
        
    }

    release
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_NewMechNPC5 {
    
    lock
    faceplayer

    if(!flag(FLAG_SPOKE_NEW_MECH_NPC)) {

        setflag(FLAG_SPOKE_NEW_MECH_NPC)
        msgbox(newMechNPCIntro_text)

    }

    call(NewMechNPC5Choices)

    release
    end

}

script NewMechNPC5Choices {

    msgbox("Now then, what new mechanics do\nyou want explained? (Press B to exit)")

    dynmultipush("Second Abilities", 0)
    dynmultipush("Sated Belch", 1)
    dynmultipush("Anodyne", 2)
    dynmultipush("Hariyama AI", 3)

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        msgbox("Stop by if you ever want\nthe new mechanics explained again!")

    }
    elif (var(VAR_RESULT) == 0) {

        msgbox(secondAbilities_text)
        call(NewMechNPC5Choices)

    }
    elif (var(VAR_RESULT) == 1) {

        msgbox(satedBelch_text)
        call(NewMechNPC5Choices)

    }
    elif (var(VAR_RESULT) == 2) {

        msgbox(anodyne_text)
        call(NewMechNPC5Choices)

    }
    elif (var(VAR_RESULT) == 3) {

        msgbox("Hariyama will always use its strongest\nmove against its current opponent.")
        call(NewMechNPC5Choices)

    }

}

