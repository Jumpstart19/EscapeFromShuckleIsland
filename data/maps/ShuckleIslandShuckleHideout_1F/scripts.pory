script ShuckleIslandShuckleHideout_1F_EventScript_CamperCellDoor {

    lockall
    
    if(!flag(FLAG_CAMPER_CELL_START) && !flag(FLAG_WON_BATTLE_7)) {

        msgbox(camperCell1_text)
        setflag(FLAG_CAMPER_CELL_START)

    }
    elif(!flag(FLAG_CAMPER_CELL_FINISH) && !flag(FLAG_WON_BATTLE_7)) {

        msgbox(camperCell2_text, MSGBOX_YESNO)

        if (var(VAR_RESULT) == YES) {

            playse(SE_M_FLATTER)
            waitse
            msgbox(camperCell2Y_text)
            setflag(FLAG_CAMPER_CELL_FINISH)

        }
        else {

            msgbox(camperCell2N_text)

        }

    }

    if (flag(FLAG_CAMPER_CELL_FINISH) && !flag(FLAG_WON_BATTLE_7)) {

        msgbox(camperCell3_text, MSGBOX_YESNO)

        if (var(VAR_RESULT) == YES) {

            playse(SE_M_FLATTER)
            waitse
            msgbox(camperCell3Y_text)

        }

    }
    elif (flag(FLAG_CAMPER_CELL_FINISH) && flag(FLAG_WON_BATTLE_7)) {

        msgbox(camperCellPost_text)

    }
    elif (flag(FLAG_WON_BATTLE_7)) {

        msgbox(campercellGone_text)

    }

    releaseall
    end

}

