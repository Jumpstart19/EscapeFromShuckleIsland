script ShuckleIslandShuckleHideout_1F_EventScript_RegiRiddle {

    lockall

    if (!flag(FLAG_SOLVED_REGI_RIDDLE)) {

        msgbox(regiRiddle_text)
        setvar(VAR_0x8004, EASY_CHAT_TYPE_GOOD_SAYING)
        call(Common_ShowEasyChatScreen)
        lockall

        if (var(VAR_RESULT) == TRUE) {

            if (var(VAR_0x8004) == NOT_SPECIAL_PHRASE) {

                playse(SE_FAILURE)
                msgbox("Try again.")
                waitse

            }
            elif ((var(VAR_0x8004) == PHRASE_REGIROCK) || (var(VAR_0x8004) == PHRASE_REGISTEEL) || (var(VAR_0x8004) == PHRASE_REGICE)) {

                playse(SE_FAILURE)
                msgbox("Come on. You're not even trying here.")
                waitse

            }
            elif ((var(VAR_0x8004) == PHRASE_SHUCKLE) || (var(VAR_0x8004) == PHRASE_SNORLAX)) {

                playse(SE_FAILURE)
                msgbox("You're just guessing at this point.\nIt's embarrassing.")
                waitse

            }
            elif ((var(VAR_0x8004) == PHRASE_BAGON)) {

                playse(SE_FAILURE)
                msgbox("That's very clever.\nBut oh so wrong.")
                waitse

            }
            elif (var(VAR_0x8004) == PHRASE_SABLEYE) {

                playse(SE_SUCCESS)
                waitse
                delay(30)
                playse(SE_SWITCH)
                waitse
                setmetatile(9, 6, 0x2CB, TRUE)
                setmetatile(10, 6, 0x2CC, FALSE)
                setmetatile(11, 6, 0x2CD, TRUE)
                special(DrawWholeMapView)
                setflag(FLAG_SOLVED_REGI_RIDDLE)
                setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 6)

            }

        }

    }
    else {

        msgbox("There's nothing more for you\nto do here.")

    }

    releaseall
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_ResetDoor {

    setmetatile(9, 6, 0x31C, TRUE)
    setmetatile(10, 6, 0x31D, TRUE)
    setmetatile(11, 6, 0x31E, TRUE)
    special(DrawWholeMapView)
    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 5)
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_ResetResetDoor {

    setvar(VAR_SHUCKLE_ISLAND_SHUCKLE_HIDEOUT_1F_STATE, 4)
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6 {

    lock
    faceplayer


     if (!flag(FLAG_SPOKE_MOVE_TUTOR_6)) {

        setflag(FLAG_SPOKE_MOVE_TUTOR_6)
        msgbox(moveTutor6Intro_text)

    }

    if (!flag(FLAG_TAUGHT_SNORLAX_MOVE) || !flag(FLAG_TAUGHT_GALLADE_MOVE)) {

        call(ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6_WhichMon)

    }
    else {

        msgbox("I hope you taught your Pokémon\nthe correct moves!")

    }

    release
    end

}

script ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6_WhichMon {

    msgbox("So, which Pokémon needs tutoring?")

    if (!flag(FLAG_TAUGHT_SNORLAX_MOVE)) {

        dynmultipush("Snorlax", 0)

    }

    if (!flag(FLAG_TAUGHT_GALLADE_MOVE)) {

        dynmultipush("Gallade", 1)

    }

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        msgbox("Come back if you ever want your\nPokémon to learn any new moves!")

    }
    elif (var(VAR_RESULT) == 0) {

        call(ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6_WhichMoveSnorlax)

    }
    elif (var(VAR_RESULT) == 1) {

        call(ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6_WhichMoveGallade)

    }

}

script ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6_WhichMoveSnorlax {

    msgbox("Which move should I teach Snorlax?")

    dynmultipush("Protect", 0)
    dynmultipush("Belly Drum", 1)

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        call(ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6_WhichMon)

    }
    elif (var(VAR_RESULT) == 0) {

        indexspeciesinparty(SPECIES_SNORLAX2)
        copyvar(VAR_TEMP_B, VAR_RESULT)

        if (var(VAR_TEMP_B) == 0) {

            setmonmoves(0, MOVE_STOCKPILE, MOVE_SWALLOW, MOVE_PROTECT, MOVE_NONE)

        }
        else {

            setmonmoves(1, MOVE_STOCKPILE, MOVE_SWALLOW, MOVE_PROTECT, MOVE_NONE)

        }
        
        special(HealPlayerParty)
        setflag(FLAG_TAUGHT_SNORLAX_MOVE)
        playse(MUS_LEVEL_UP)
        msgbox("Your Snorlax learned Protect!")
        waitse

    }
    elif (var(VAR_RESULT) == 1) {

        indexspeciesinparty(SPECIES_SNORLAX2)
        copyvar(VAR_TEMP_B, VAR_RESULT)

        if (var(VAR_TEMP_B) == 0) {

            setmonmoves(0, MOVE_STOCKPILE, MOVE_SWALLOW, MOVE_BELLY_DRUM, MOVE_NONE)

        }
        else {

            setmonmoves(1, MOVE_STOCKPILE, MOVE_SWALLOW, MOVE_BELLY_DRUM, MOVE_NONE)

        }
        
        special(HealPlayerParty)
        setflag(FLAG_TAUGHT_SNORLAX_MOVE)
        playse(MUS_LEVEL_UP)
        msgbox("Your Snorlax learned Belly Drum!")
        waitse

    }

}

script ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6_WhichMoveGallade {

    msgbox("Which move should I teach Gallade?")

    dynmultipush("Protect", 0)
    dynmultipush("Charm", 1)

    dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)

    if (var(VAR_RESULT) == 127) {

        call(ShuckleIslandShuckleHideout_1F_EventScript_MoveTutor6_WhichMon)

    }
    elif (var(VAR_RESULT) == 0) {

        indexspeciesinparty(SPECIES_GALLADE)
        copyvar(VAR_TEMP_B, VAR_RESULT)

        if (var(VAR_TEMP_B) == 0) {

            setmonmoves(0, MOVE_GRUDGE, MOVE_PROTECT, MOVE_NONE, MOVE_NONE)

        }
        else {

            setmonmoves(1, MOVE_GRUDGE, MOVE_PROTECT, MOVE_NONE, MOVE_NONE)

        }
        
        special(HealPlayerParty)
        setflag(FLAG_TAUGHT_GALLADE_MOVE)
        playse(MUS_LEVEL_UP)
        msgbox("Your Gallade learned Protect!")
        waitse

    }
    elif (var(VAR_RESULT) == 1) {

        indexspeciesinparty(SPECIES_GALLADE)
        copyvar(VAR_TEMP_B, VAR_RESULT)

        if (var(VAR_TEMP_B) == 0) {

            setmonmoves(0, MOVE_GRUDGE, MOVE_CHARM, MOVE_NONE, MOVE_NONE)

        }
        else {

            setmonmoves(1, MOVE_GRUDGE, MOVE_CHARM, MOVE_NONE, MOVE_NONE)

        }
        
        special(HealPlayerParty)
        setflag(FLAG_TAUGHT_GALLADE_MOVE)
        playse(MUS_LEVEL_UP)
        msgbox("Your Gallade learned Charm!")
